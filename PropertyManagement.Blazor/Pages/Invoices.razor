@page "/invoices"
@attribute [Authorize(Roles = "Administrator,Staff,Contractor,Tenant")]
@inject PropertyManagementApiClient ApiClient
@inject AccessControlService AccessControl
@inject Microsoft.JSInterop.IJSRuntime JsRuntime

<PageTitle>Invoices</PageTitle>

<div class="page-header">
    <div>
        <h1>Invoices</h1>
        <p class="page-intro">Manage billing for maintenance work and rent-related charges from one clean admin page.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success alert-dismissible" role="status">
        @successMessage
        <button type="button" class="btn-close" aria-label="Close" @onclick="ClearSuccessMessage"></button>
    </div>
}

<div class="dashboard-grid">
    <section class="stat-card compact-card">
        <span class="stat-label">Total invoiced</span>
        <strong>@invoices.Sum(item => item.TotalAmount).ToString("C0")</strong>
    </section>
    <section class="stat-card compact-card">
        <span class="stat-label">Outstanding</span>
        <strong>@invoices.Where(item => item.Status is "Draft" or "Sent" or "Overdue").Sum(item => item.TotalAmount).ToString("C0")</strong>
    </section>
    <section class="stat-card compact-card">
        <span class="stat-label">Overdue count</span>
        <strong>@invoices.Count(item => item.Status == "Overdue")</strong>
    </section>
    <section class="stat-card compact-card">
        <span class="stat-label">Exported</span>
        <strong>@invoices.Count(item => item.IsExported)</strong>
    </section>
</div>

<div class="workspace-grid">
    @if (user.CanEditInvoices)
    {
        <section class="glass-panel">
            <div class="section-header">
                <div>
                    <h3>@(editingInvoiceId is null ? "Create invoice" : "Edit invoice")</h3>
                    <p class="page-intro">Link an invoice to maintenance work@(user.IsAdmin ? ", a rent schedule, or leave it standalone." : ".")</p>
                </div>
            </div>

        <EditForm class="record-form" Model="form" OnValidSubmit="SaveInvoiceAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Maintenance project (optional)</label>
                <InputSelect TValue="int?" class="form-select" @bind-Value="form.ProjectId">
                    <option value="">Not linked</option>
                    @foreach (var project in projects)
                    {
                        <option value="@project.ProjectId">@project.ProjectTitle</option>
                    }
                </InputSelect>
            </div>

            @if (user.IsAdmin)
            {
                <div class="mb-3">
                    <label class="form-label">Rent schedule (optional)</label>
                    <InputSelect TValue="int?" class="form-select" @bind-Value="form.ScheduleId">
                        <option value="">Not linked</option>
                        @foreach (var schedule in schedules)
                        {
                            <option value="@schedule.ScheduleId">@schedule.SummaryLabel</option>
                        }
                    </InputSelect>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Invoice date</label>
                <InputDate class="form-control" @bind-Value="form.InvoiceDate" />
            </div>

            <div class="mb-3">
                <label class="form-label">Total amount</label>
                <InputNumber class="form-control" @bind-Value="form.TotalAmount" disabled="@(form.LineItems.Count > 0)" />
                @if (form.LineItems.Count > 0)
                {
                    <div class="form-text">Calculated from line items: @form.LineItemsTotal.ToString("C")</div>
                }
            </div>

            <div class="mb-3">
                <div class="section-header compact-section-header">
                    <div>
                        <h3>Line items</h3>
                        <p class="page-intro">Add labor, material, rent, tax, or fee rows for a clearer invoice total.</p>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddLineItem">Add line</button>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Type</th>
                                <th>Qty</th>
                                <th>Unit price</th>
                                <th>Total</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in form.LineItems)
                            {
                                <tr>
                                    <td><InputText class="form-control" @bind-Value="item.Description" /></td>
                                    <td>
                                        <InputSelect class="form-select" @bind-Value="item.ItemType">
                                            @foreach (var type in lineItemTypes)
                                            {
                                                <option value="@type">@type</option>
                                            }
                                        </InputSelect>
                                    </td>
                                    <td><InputNumber class="form-control" @bind-Value="item.Quantity" /></td>
                                    <td><InputNumber class="form-control" @bind-Value="item.UnitPrice" /></td>
                                    <td>@item.LineTotal.ToString("C")</td>
                                    <td class="action-cell">
                                        <button class="btn btn-sm btn-danger" type="button" disabled="@(form.LineItems.Count == 1)" @onclick="() => RemoveLineItem(item)">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>
                <InputSelect class="form-select" @bind-Value="form.Status">
                    @foreach (var status in invoiceStatuses)
                    {
                        <option value="@status">@status</option>
                    }
                </InputSelect>
            </div>

            <div class="form-check mb-3">
                <InputCheckbox class="form-check-input" @bind-Value="form.IsExported" />
                <label class="form-check-label">Marked as exported</label>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" type="submit" disabled="@isSaving">@(isSaving ? "Saving..." : "Save invoice")</button>
                <button class="btn btn-outline-primary" type="button" @onclick="ResetForm">Clear</button>
            </div>
        </EditForm>
    </section>
    }

    <section class="glass-panel">
        <div class="section-header">
            <div>
                <h3>Invoice pipeline</h3>
                <p class="page-intro">Filter by status and monitor billing progress across all linked modules.</p>
            </div>
        </div>

        <div class="filter-row mb-3">
            <div>
                <label class="form-label">Status filter</label>
                <InputSelect class="form-select" @bind-Value="selectedStatus">
                    <option value="">All</option>
                    @foreach (var status in invoiceStatuses)
                    {
                        <option value="@status">@status</option>
                    }
                </InputSelect>
            </div>
            <button class="btn btn-outline-primary" type="button" @onclick="LoadAsync">Apply</button>
            <button class="btn btn-outline-primary" type="button" @onclick="ExportInvoicesAsync">Export CSV</button>
        </div>

        @if (isLoading)
        {
            <p>Loading invoices...</p>
        }
        else if (invoices.Count == 0)
        {
            <p>No invoices match the current filter.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Customer</th>
                            <th>Property</th>
                            <th>Status</th>
                            <th>Amount</th>
                            @if (ShowActionsColumn)
                            {
                                <th class="text-end">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in invoices)
                        {
                            <tr>
                                <td>
                                    <div>@invoice.ReferenceName</div>
                                    <small class="text-muted">@invoice.InvoiceDate.ToString("yyyy-MM-dd")</small>
                                    @if (invoice.LineItems.Count > 0)
                                    {
                                        <div class="mini-note">@invoice.LineItems.Count line item@(invoice.LineItems.Count == 1 ? string.Empty : "s")</div>
                                    }
                                </td>
                                <td>@invoice.CustomerName</td>
                                <td>@invoice.PropertyName</td>
                                <td><span class="@invoice.StatusCssClass">@invoice.Status</span></td>
                                <td>@invoice.TotalAmount.ToString("C")</td>
                                @if (ShowActionsColumn)
                                {
                                    <td class="action-cell">
                                        @if (CanSendReminder(invoice))
                                        {
                                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => SendInvoiceReminderAsync(invoice)">Reminder</button>
                                        }
                                        @if (user.CanEditInvoices)
                                        {
                                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => BeginEdit(invoice)">Edit</button>
                                            <button class="btn btn-sm btn-danger" type="button" @onclick="() => DeleteInvoiceAsync(invoice.InvoiceId)">Delete</button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private static readonly string[] invoiceStatuses = ["Draft", "Sent", "Paid", "Overdue"];
    private static readonly string[] lineItemTypes = ["Labor", "Material", "Rent", "Fee", "Tax", "Other"];

    private List<InvoiceModel> invoices = [];
    private List<MaintenanceProjectModel> projects = [];
    private List<RentScheduleModel> schedules = [];
    private InvoiceFormModel form = new();
    private bool isLoading = true;
    private bool isSaving;
    private int? editingInvoiceId;
    private string selectedStatus = string.Empty;
    private string? errorMessage;
    private string? successMessage;
    private UserAccessProfile user = UserAccessProfile.Anonymous;
    private bool ShowActionsColumn => user.CanEditInvoices || invoices.Any(CanSendReminder);

    protected override async Task OnInitializedAsync()
    {
        user = await AccessControl.GetUserAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var tenantId = user.IsTenant ? user.TenantId : null;
            var invoicesTask = ApiClient.GetInvoicesAsync(status: selectedStatus, tenantId: tenantId);
            var projectsTask = user.CanEditInvoices
                ? ApiClient.GetMaintenanceProjectsAsync()
                : Task.FromResult(new List<MaintenanceProjectModel>());
            var schedulesTask = user.IsAdmin
                ? ApiClient.GetRentSchedulesAsync()
                : Task.FromResult(new List<RentScheduleModel>());

            await Task.WhenAll(invoicesTask, projectsTask, schedulesTask);

            invoices = user.IsContractor
                ? invoicesTask.Result.Where(invoice => invoice.ProjectId.HasValue).ToList()
                : invoicesTask.Result;
            projects = projectsTask.Result;
            schedules = schedulesTask.Result;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveInvoiceAsync()
    {
        if (user.IsContractor)
        {
            if (!form.ProjectId.HasValue)
            {
                errorMessage = "Contractor invoices must be linked to a maintenance project.";
                return;
            }

            form.ScheduleId = null;
        }

        PrepareInvoiceTotal();
        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            if (editingInvoiceId is int invoiceId)
            {
                await ApiClient.UpdateInvoiceAsync(invoiceId, form);
            }
            else
            {
                await ApiClient.CreateInvoiceAsync(form);
            }

            await LoadAsync();
            ResetForm();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void BeginEdit(InvoiceModel invoice)
    {
        editingInvoiceId = invoice.InvoiceId;
        form = InvoiceFormModel.FromInvoice(invoice);
        errorMessage = null;
        successMessage = null;
    }

    private async Task DeleteInvoiceAsync(int invoiceId)
    {
        try
        {
            await ApiClient.DeleteInvoiceAsync(invoiceId);
            await LoadAsync();

            if (editingInvoiceId == invoiceId)
            {
                ResetForm();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ResetForm()
    {
        form = new InvoiceFormModel();
        editingInvoiceId = null;
        errorMessage = null;
        successMessage = null;
    }

    private bool CanSendReminder(InvoiceModel invoice)
    {
        return user.IsAdmin &&
            invoice.TenantId.HasValue &&
            invoice.Status is "Sent" or "Overdue";
    }

    private async Task SendInvoiceReminderAsync(InvoiceModel invoice)
    {
        if (!CanSendReminder(invoice) || !invoice.TenantId.HasValue)
        {
            return;
        }

        try
        {
            errorMessage = null;
            successMessage = null;

            await ApiClient.CreateCommunicationLogAsync(new CommunicationLogFormModel
            {
                TenantId = invoice.TenantId.Value,
                ScheduleId = invoice.ScheduleId,
                LoggedAt = DateTime.Now,
                Channel = "Notice",
                Subject = $"Invoice #{invoice.InvoiceId} reminder",
                Message = $"Reminder: invoice #{invoice.InvoiceId} for {invoice.ReferenceName} has a balance of {invoice.TotalAmount:C} and is currently {invoice.Status}.",
                CreatedBy = user.UserName
            });

            successMessage = $"Reminder logged for {invoice.CustomerName}.";
            _ = ClearSuccessMessageAfterDelayAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ClearSuccessMessage()
    {
        successMessage = null;
    }

    private async Task ClearSuccessMessageAfterDelayAsync()
    {
        await Task.Delay(TimeSpan.FromSeconds(5));
        successMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    private void AddLineItem()
    {
        form.LineItems.Add(new InvoiceLineItemFormModel());
        PrepareInvoiceTotal();
    }

    private void RemoveLineItem(InvoiceLineItemFormModel item)
    {
        if (form.LineItems.Count <= 1)
        {
            return;
        }

        form.LineItems.Remove(item);
        PrepareInvoiceTotal();
    }

    private void PrepareInvoiceTotal()
    {
        var populatedLineItems = form.LineItems
            .Where(item => !string.IsNullOrWhiteSpace(item.Description) && item.Quantity > 0)
            .ToList();

        if (populatedLineItems.Count > 0)
        {
            form.TotalAmount = populatedLineItems.Sum(item => item.LineTotal);
        }
    }

    private async Task ExportInvoicesAsync()
    {
        var rows = new List<string>
        {
            "InvoiceId,Date,Reference,Customer,Property,Status,Amount,Exported,LineItems"
        };

        rows.AddRange(invoices.Select(invoice =>
            string.Join(",",
                invoice.InvoiceId,
                EscapeCsv(invoice.InvoiceDate.ToString("yyyy-MM-dd")),
                EscapeCsv(invoice.ReferenceName),
                EscapeCsv(invoice.CustomerName),
                EscapeCsv(invoice.PropertyName),
                EscapeCsv(invoice.Status),
                invoice.TotalAmount.ToString("0.00"),
                invoice.IsExported ? "Yes" : "No",
                EscapeCsv(string.Join(" | ", invoice.LineItems.Select(item => $"{item.Description}: {item.LineTotal:C}"))))));

        await JsRuntime.InvokeVoidAsync(
            "pmDownloads.downloadText",
            $"invoices-{DateTime.Today:yyyyMMdd}.csv",
            "text/csv;charset=utf-8",
            string.Join(Environment.NewLine, rows));
    }

    private static string EscapeCsv(string value)
    {
        return "\"" + value.Replace("\"", "\"\"") + "\"";
    }
}
