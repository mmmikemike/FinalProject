@inject AccessControlService AccessControl

<AuthorizeView>
    <Authorized>
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="">Property Manager</a>
                <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </div>

        <div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
            <nav class="nav flex-column">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </div>
                @if (user.CanViewProperties)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="properties">
                            <span class="bi bi-building-nav-menu" aria-hidden="true"></span> Properties
                        </NavLink>
                    </div>
                }
                @if (user.CanViewTenants)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="tenants">
                            <span class="bi bi-people-nav-menu" aria-hidden="true"></span> Tenants
                        </NavLink>
                    </div>
                }
                @if (user.CanViewRentSchedules)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="rent-schedules">
                            <span class="bi bi-calendar-nav-menu" aria-hidden="true"></span> Rent Schedules
                        </NavLink>
                    </div>
                }
                @if (user.CanViewRentPayments)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="rent-payments">
                            <span class="bi bi-credit-card-nav-menu" aria-hidden="true"></span> Rent Payments
                        </NavLink>
                    </div>
                }
                @if (user.CanViewRentRecords)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="rent-records">
                            <span class="bi bi-ledger-nav-menu" aria-hidden="true"></span> Rent Records
                        </NavLink>
                    </div>
                }
                @if (user.CanViewMaintenance)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="maintenance-projects">
                            <span class="bi bi-tools-nav-menu" aria-hidden="true"></span> Maintenance
                        </NavLink>
                    </div>
                }
                @if (user.CanViewInvoices)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="invoices">
                            <span class="bi bi-receipt-nav-menu" aria-hidden="true"></span> Invoices
                        </NavLink>
                    </div>
                }
                @if (user.CanViewApplications)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="applications">
                            <span class="bi bi-clipboard-nav-menu" aria-hidden="true"></span> Applications
                        </NavLink>
                    </div>
                }
            </nav>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private bool collapseNavMenu = true;
    private UserAccessProfile user = UserAccessProfile.Anonymous;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        user = await AccessControl.GetUserAsync();
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
